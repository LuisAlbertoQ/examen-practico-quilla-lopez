<group name="local,exfiltration,">
  <!--
    REGLA COMPUESTA DE EXFILTRACION DE DATOS
    Logica:
    1. La regla 100010 detecta un login SSH exitoso fuera del horario laboral (22:00-06:00).
    2. La regla 100020 detecta una transferencia saliente de gran tamano (>500MB).
    3. La regla 100030 correlaciona ambos eventos usando if_matched_sid secuencial.
  -->

  <!-- Regla 1: Login SSH exitoso fuera del horario laboral -->
  <rule id="100010" level="8">
    <if_sid>5715</if_sid>
    <field name="hour" type="osmatch">^(22|23|00|01|02|03|04|05)$</field>
    <description>Login SSH exitoso fuera del horario laboral (22:00-06:00) desde $(srcip)</description>
    <group>authentication_success,suspicious_hours,</group>
  </rule>

  <!-- Regla 2: Transferencia de datos saliente de gran tamano -->
  <rule id="100020" level="6">
    <match>bytes_out|MB|exfiltracion</match>
    <description>Transferencia saliente masiva detectada desde $(srcip)</description>
    <group>exfiltration,data_transfer,</group>
  </rule>

  <!-- Regla 3: Correlacion login off-hours + transferencia masiva (NIVEL CRITICO) -->
  <rule id="100030" level="14" frequency="2" timeframe="3600">
    <if_matched_sid>100010</if_matched_sid>
    <same_source_ip />
    <description>POSIBLE EXFILTRACION DE DATOS: Login fuera de horario seguido de transferencia masiva >500MB desde $(srcip)</description>
    <group>exfiltration,critical,data_breach,</group>
  </rule>

</group>
